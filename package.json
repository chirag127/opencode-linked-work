{
  "name": "opencode-linked-work",
  "version": "0.1.0",
  "description": "Project-scoped issue and review URL associations for native OpenCode sessions",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/linked-work.test.mjs test/archive-binding.test.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test:pack": "node scripts/test-pack.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.2",
    "@opencode/schema": "2.3.2",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "semver": "7.8.6",
    "tar": "7.5.23",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "repository": { "type": "git", "url": "git+https://github.com/chirag127/opencode-linked-work.git" }
}
